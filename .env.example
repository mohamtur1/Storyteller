# Storyteller — copy to .env and fill in what you have.
# EVERYTHING works with zero keys. These only make it better.

# --- Scriptwriting (optional, template engine works without) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Images (optional, Openverse/Wikimedia work without) ---
PEXELS_API_KEY=

# --- YouTube upload (optional, manual-upload package works without) ---
# 1. Google Cloud Console -> enable YouTube Data API v3
# 2. OAuth 2.0 credentials (Desktop) -> save as credentials.json in project root
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Google Drive (optional, local projects/ folder works without) ---
DRIVE_FOLDER_ID=

# --- Server ---
HOST=0.0.0.0
PORT=8000
PROJECTS_DIR=projects
